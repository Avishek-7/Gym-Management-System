rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /**
     * Check if user role document exists
     */
    function userRoleExists(userId) {
      return exists(/databases/$(database)/documents/userRoles/$(userId));
    }
    
    /**
     * Get user's role from userRoles collection
     * Returns null if role doesn't exist
     */
    function getUserRole(userId) {
      return userRoleExists(userId) ? get(/databases/$(database)/documents/userRoles/$(userId)).data.role : null;
    }
    
    /**
     * Check if authenticated user has a specific role
     */
    function hasRole(role) {
      return isAuthenticated() && getUserRole(request.auth.uid) == role;
    }
    
    /**
     * Check if authenticated user has any of the specified roles
     */
    function hasAnyRole(roles) {
      return isAuthenticated() && getUserRole(request.auth.uid) in roles;
    }
    
    /**
     * Check if user is admin
     */
    function isAdmin() {
      return hasRole('admin');
    }
    
    /**
     * Check if user is member
     */
    function isMember() {
      return hasRole('member');
    }
    
    /**
     * Check if user is trainer
     */
    function isTrainer() {
      return hasRole('trainer');
    }
    
    /**
     * Check if user is accessing their own document
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========================================
    // USER ROLES COLLECTION
    // ========================================
    
    match /userRoles/{userId} {
      // Users can read their own role (even if it doesn't exist yet)
      // Admins can read any role
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Allow creating a role for a new user (first-time only)
      // This allows registration to set default 'member' role
      allow create: if isAuthenticated() && isOwner(userId) && !exists(/databases/$(database)/documents/userRoles/$(userId));
      
      // Only admins can update/delete roles after initial creation
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // MEMBERS COLLECTION
    // ========================================
    
    match /members/{memberId} {
      // All authenticated users can read member data
      allow read: if isAuthenticated();
      
      // Only admins can create, update, or delete members
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // BILLS COLLECTION
    // ========================================
    
    match /bills/{billId} {
      // Admins can read all bills
      // Members can only read their own bills
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can create, update, or delete bills
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // SUBSCRIPTIONS COLLECTION
    // ========================================
    
    match /subscriptions/{subscriptionId} {
      // Admins can read all subscriptions
      // Members can only read their own subscriptions
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can create, update, or delete subscriptions
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // PAYMENTS COLLECTION
    // ========================================
    
    match /payments/{paymentId} {
      // Admins can read all payments
      // Members can only read their own payments
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can create or update payments
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // RECEIPTS COLLECTION
    // ========================================
    
    match /receipts/{receiptId} {
      // Admins can read all receipts
      // Members can only read their own receipts
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can create, update, or delete receipts
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // NOTIFICATIONS COLLECTION
    // ========================================
    
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Admins and trainers can create notifications
      allow create: if isAdmin() || isTrainer();
      
      // Users can update their own notifications (e.g., mark as read)
      // Admins can update any notification
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can delete notifications
      allow delete: if isAdmin();
    }
    
    // ========================================
    // NOTIFICATION TEMPLATES COLLECTION
    // ========================================
    
    match /notificationTemplates/{templateId} {
      // All authenticated users can read templates
      allow read: if isAuthenticated();
      
      // Only admins can create, update, or delete templates
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // NOTIFICATION PREFERENCES COLLECTION
    // ========================================
    
    match /notificationPreferences/{preferenceId} {
      // Users can read their own preferences
      // Admins can read any preferences
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Users can create/update their own preferences
      // Admins can create/update any preferences
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can delete preferences
      allow delete: if isAdmin();
    }
    
    // ========================================
    // SCHEDULED NOTIFICATIONS COLLECTION
    // ========================================
    
    match /scheduledNotifications/{scheduledId} {
      // Admins can read all scheduled notifications
      // Users can read their own scheduled notifications
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can create, update, or delete scheduled notifications
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // SUPPLEMENTS COLLECTION
    // ========================================
    
    match /supplements/{supplementId} {
      // All authenticated users can read supplements
      allow read: if isAuthenticated();
      
      // Only admins can create, update, or delete supplements
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // SUPPLEMENT SALES COLLECTION
    // ========================================
    
    match /supplementSales/{saleId} {
      // Admins can read all sales
      // Members can only read their own sales
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.memberId == request.auth.uid
      );
      
      // Only admins can create, update, or delete sales
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // SUPPLEMENT STOCK HISTORY COLLECTION
    // ========================================
    
    match /supplementStockHistory/{historyId} {
      // Only admins can read stock history
      allow read: if isAdmin();
      
      // Only admins can create stock history records
      allow create: if isAdmin();
      
      // Stock history records should not be updated or deleted
      allow update: if false;
      allow delete: if false;
    }
    
    // ========================================
    // CLASSES COLLECTION
    // ========================================
    
    match /classes/{classId} {
      // All authenticated users can read classes
      allow read: if isAuthenticated();
      
      // Admins and trainers can create, update classes
      allow create: if isAdmin() || isTrainer();
      allow update: if isAdmin() || isTrainer();
      
      // Only admins can delete classes
      allow delete: if isAdmin();
    }
    
    // ========================================
    // ATTENDANCE COLLECTION
    // ========================================
    
    match /attendance/{attendanceId} {
      // Admins and trainers can read all attendance
      // Members can only read their own attendance
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTrainer() || 
        resource.data.memberId == request.auth.uid
      );
      
      // Admins and trainers can create/update attendance
      allow create: if isAdmin() || isTrainer();
      allow update: if isAdmin() || isTrainer();
      
      // Only admins can delete attendance records
      allow delete: if isAdmin();
    }
    
    // ========================================
    // INVENTORY COLLECTION
    // ========================================
    
    match /inventory/{itemId} {
      // All authenticated users can read inventory
      allow read: if isAuthenticated();
      
      // Only admins can manage inventory
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // REPORTS COLLECTION
    // ========================================
    
    match /reports/{reportId} {
      // Only admins can access reports
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // ANALYTICS COLLECTION
    // ========================================
    
    match /analytics/{analyticId} {
      // Only admins can access analytics
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // TRAINERS COLLECTION
    // ========================================
    
    match /trainers/{trainerId} {
      // All authenticated users can read trainer profiles
      allow read: if isAuthenticated();
      
      // Trainers can update their own profile
      // Admins can update any trainer profile
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isOwner(trainerId)
      );
      
      // Only admins can create or delete trainers
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // MEMBERSHIPS COLLECTION
    // ========================================
    
    match /memberships/{membershipId} {
      // All authenticated users can read membership types
      allow read: if isAuthenticated();
      
      // Only admins can manage membership types
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // PACKAGES COLLECTION (FEE PACKAGES)
    // ========================================
    
    match /packages/{packageId} {
      // All authenticated users can read packages
      allow read: if isAuthenticated();
      
      // Only admins can create, update, or delete packages
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // GYM CLASSES COLLECTION
    // ========================================
    
    match /gymClasses/{classId} {
      // All authenticated users can read gym classes
      allow read: if isAuthenticated();
      
      // Admins and trainers can create, update classes
      allow create: if isAdmin() || isTrainer();
      allow update: if isAdmin() || isTrainer();
      
      // Only admins can delete classes
      allow delete: if isAdmin();
    }
    
    // ========================================
    // CLASS SESSIONS COLLECTION
    // ========================================
    
    match /classSessions/{sessionId} {
      // All authenticated users can read class sessions
      allow read: if isAuthenticated();
      
      // Admins and trainers can create, update sessions
      allow create: if isAdmin() || isTrainer();
      allow update: if isAdmin() || isTrainer();
      
      // Only admins can delete sessions
      allow delete: if isAdmin();
    }
    
    // ========================================
    // CLASS ATTENDANCE COLLECTION
    // ========================================
    
    match /classAttendance/{attendanceId} {
      // Admins and trainers can read all attendance
      // Members can only read their own attendance
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTrainer() || 
        resource.data.memberId == request.auth.uid
      );
      
      // Admins and trainers can create/update attendance
      allow create: if isAdmin() || isTrainer();
      allow update: if isAdmin() || isTrainer();
      
      // Only admins can delete attendance records
      allow delete: if isAdmin();
    }
    
    // ========================================
    // USER PROFILES COLLECTION
    // ========================================
    
    match /userProfiles/{userId} {
      // Users can read their own profile
      // Admins can read any profile
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isOwner(userId)
      );
      
      // Users can create/update their own profile
      // Admins can create/update any profile
      allow create: if isAuthenticated() && (
        isAdmin() || 
        isOwner(userId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isOwner(userId)
      );
      
      // Only admins can delete profiles
      allow delete: if isAdmin();
    }
    
    // ========================================
    // DIET PLANS COLLECTION
    // ========================================
    
    match /dietPlans/{planId} {
      // Admins can read all diet plans
      // Members can only read their own diet plans
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.memberId == request.auth.uid
      );
      
      // Only admins can create, update, or delete diet plans
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // DIET PROGRESS COLLECTION
    // ========================================
    
    match /dietProgress/{progressId} {
      // Admins can read all diet progress
      // Members can only read their own diet progress
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.memberId == request.auth.uid
      );
      
      // Admins can create/update diet progress
      // Members can create/update their own progress
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.memberId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.memberId == request.auth.uid
      );
      
      // Only admins can delete diet progress
      allow delete: if isAdmin();
    }
    
    // ========================================
    // DIET TEMPLATES COLLECTION
    // ========================================
    
    match /dietTemplates/{templateId} {
      // All authenticated users can read public templates
      // Admins can read all templates
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.isPublic == true
      );
      
      // Only admins can create, update, or delete templates
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // PENDING APPROVALS COLLECTION
    // ========================================
    
    match /pendingApprovals/{approvalId} {
      // Admins can read all approval requests
      // Users can read their own approval requests
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Users can create approval requests for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Only admins can update (approve/reject) or delete approval requests
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========================================
    // DEFAULT DENY ALL
    // ========================================
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}